# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Do not commit real passwords.

# Postgres container (must match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kidneylens
POSTGRES_USER=kidneylens
POSTGRES_PASSWORD=local_dev_password

# Read-only user for the Streamlit app (created in a later milestone)
APP_DB_USER=kidneylens_reader
APP_DB_PASSWORD=change_me_too

# Source data (leave blank to use DEFAULT_URL in ingestion/download.py; CMS changes it each release)
CMS_FACILITY_CSV_URL=

# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Do not commit real passwords.

# Postgres container (must match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kidneylens
POSTGRES_USER=kidneylens
POSTGRES_PASSWORD=local_dev_password

# Read-only user for the Streamlit app (created by sql/create_app_role.sql)
APP_DB_USER=kidneylens_app
APP_DB_PASSWORD=local_app_password

# Source data (leave blank to use DEFAULT_URL in ingestion/download.py; CMS changes it each release)
CMS_FACILITY_CSV_URL=

# Claude intent classification (app/classifier.py). Never commit a real key.
ANTHROPIC_API_KEY=
